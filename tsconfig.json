{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "types": ["react", "react-native"]
  },
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "#1",
    "backup",
    "blyp-gaming-features",
    "blyp-multiplayer-games",
    "functions",
    "admin",
    "backend",
    "_agent",
    ".manus-work",
    "diagnostics",
    "tools/accountability",
    "_reports",
    "_reports/**",
    "scripts/**",
    "**/*.d.ts"
  ]
}
