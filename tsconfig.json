{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "types": [
      "react",
      "react-native",
      "jest"
    ]
  },
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "admin",
    "admin/**",
    "amplify",
    "amplify/**",
    "diagnostics",
    "diagnostics/**",
    "artifacts",
    "artifacts/**",
    "#1",
    "backup",
    "blyp-gaming-features",
    "functions",
    "_reports",
    "_reports/**",
    "scripts/**",
    "backend",
    "backend/**",
    "tools/accountability",
    "tools/accountability/**"
  ]
}
