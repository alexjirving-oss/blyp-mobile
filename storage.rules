rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidVideoSegment() {
      return request.resource.size < 10 * 1024 * 1024 // 10MB max per segment
        && request.resource.contentType.matches('video/.*|application/octet-stream');
    }
    
    function isValidThumbnail() {
      return request.resource.size < 5 * 1024 * 1024 // 5MB max for thumbnails
        && request.resource.contentType.matches('image/.*');
    }
    
    // ========== STREAM SEGMENTS & THUMBNAILS ==========
    
    // Stream segments path: streams/{userId}/{streamId}/segment_{N}.mp4
    // Only the owner can write, everyone can read (for playback)
    match /streams/{userId}/{streamId}/{fileName} {
      // Public read for viewer playback
      allow read: if true;
      
      // Only the stream owner can upload segments/thumbnails
      allow write: if isOwner(userId)
        && (
          (fileName.matches('segment_[0-9]+\\.mp4') && isValidVideoSegment())
          || (fileName.matches('thumbnail_[0-9]+\\.(jpg|png)') && isValidThumbnail())
        );
      
      // Only the owner can delete
      allow delete: if isOwner(userId);
    }
    
    // ========== USER PROFILE IMAGES ==========
    
    // User profile images: userProfiles/{userId}/profile.{ext}
    match /userProfiles/{userId}/{fileName} {
      allow read: if true;
      
      allow write: if isOwner(userId)
        && isValidThumbnail();
      
      allow delete: if isOwner(userId);
    }
    
    // ========== DEFAULT DENY ==========
    // All other paths are denied by default
  }
}
