# Spotify Connect (LIVE Studio jukebox) — PKCE in the browser; refresh token stored
# in Netlify Blobs at user:{cognitoSub}. Tokens come from Spotify only (exchange +
# refresh-on-401). Secret optional — PKCE works without it. Never commit secrets.
# Dashboard redirect URIs (exact, trailing slash). Spotify rejects localhost;
# local loopback must be 127.0.0.1 (they are different URIs — keep these 2 only):
#   https://blyp.world/live/studio/
#   http://127.0.0.1:3000/live/studio/
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
# Optional; if unset, uses the current origin + /live/studio/
# (http://localhost is rewritten to http://127.0.0.1 before building redirect_uri)
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=
# Netlify function (same Client ID as public). Secret optional — PKCE works without it.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Server-only — required for Stripe Checkout top-ups
STRIPE_SECRET_KEY=
# Optional Price IDs (otherwise Checkout uses price_data)
STRIPE_PRICE_WEB_COINPACK_100=
STRIPE_PRICE_WEB_COINPACK_550=
STRIPE_PRICE_WEB_COINPACK_1150=
STRIPE_PRICE_WEB_COINPACK_3000=
STRIPE_PRICE_WEB_COINPACK_6500=
