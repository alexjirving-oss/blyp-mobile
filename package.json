{
  "name": "blyp-mobile",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "dev-client": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "live:e2e": "powershell -ExecutionPolicy Bypass -File scripts\\run_live_e2e.ps1",
    "eas-build-pre-install": "node scripts/write-google-services.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:forward": "npm run lint && npm run typecheck && npm test -- --ci --runInBand && npm --prefix backend/blyp-live-service run test && npm --prefix functions run build && npm --prefix admin run lint && npm --prefix admin run build",
    "verify:session": "npm run verify:forward",
    "verify:live": "node scripts/verified-forward-gate.js --live-only",
    "test:hooks": "powershell -ExecutionPolicy Bypass -File tools/agent/test-hooks.ps1",
    "test:acceptance": "powershell -ExecutionPolicy Bypass -File tools/agent/acceptance.ps1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "eas-build-post-install": "node scripts/generate-aws-exports.js",
    "clean": "npx expo-doctor && npx expo install --check --fix",
    "clean-build": "Get-Process | Where-Object {$_.ProcessName -like '*node*' -or $_.ProcessName -like '*expo*' -or $_.ProcessName -like '*metro*'} | Stop-Process -Force; npm start -- --clear --reset-cache",
    "build:dev": "eas build --profile development --platform android --clear-cache",
    "build:eas:android": "eas build --platform android",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "submit:eas:android": "eas submit --platform android",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "test:rules:firestore": "node scripts/test-firestore-rules.js",
    "test:rules:storage": "node scripts/test-storage-rules.js",
    "test:rules:unit": "npm run test:rules:firestore && npm run test:rules:storage",
    "test:rules": "firebase emulators:exec --only \"firestore,storage\" \"npm run test:rules:unit\"",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output _reports/bundles/index.android.bundle --sourcemap-output _reports/bundles/index.android.map --assets-dest _reports/bundles/assets",
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output _reports/bundles/index.ios.bundle --sourcemap-output _reports/bundles/index.ios.map --assets-dest _reports/bundles/assets",
    "perf:analyze": "source-map-explorer _reports/bundles/index.android.bundle _reports/bundles/index.android.map --json > _reports/prod_audit_v2/findings/sme.android.json",
    "accountability:install": "npm ci --prefix tools/accountability",
    "accountability:check": "npm test --prefix tools/accountability",
    "accountability:keygen": "npm --prefix tools/accountability run --silent start -- keygen",
    "accountability:validate": "npm --prefix tools/accountability run start -- validate",
    "accountability": "npm --prefix tools/accountability run start -- run",
    "accountability:verify-ledger": "npm --prefix tools/accountability run start -- verify-ledger",
    "accountability:verify-session": "npm run build --prefix tools/accountability && node tools/accountability/dist/src/cli.js verify-session --repo . --session .cursor/agent/session.json",
    "accountability:validate-receipt": "npm --prefix tools/accountability run start -- validate-receipt",
    "accountability:test-hooks": "python -m unittest discover -s tools/accountability/tests-python -p \"test_*.py\"",
    "accountability:acceptance": "npm run accountability:check && npm run accountability:test-hooks",
    "accountability:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/accountability/run-smoke.ps1",
    "qa": "node scripts/qa-gate.js",
    "debug:ivs-host-token": "ts-node scripts/debug/ivsHostTokenSmoke.ts",
    "postinstall": "node scripts/postinstall.cjs",
    "verify:proof": "powershell -ExecutionPolicy Bypass -File scripts\\verify_report.ps1",
    "icons:android": "node scripts/generate-android-launcher-icons.mjs assets/icon.png",
    "play:upload": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/release/UPLOAD_PLAY_AAB.ps1",
    "play:bake": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/release/BUILD_RELEASE_CANDIDATE.ps1",
    "tiktok:companion": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/blyp-tiktok-companion/start-companion.ps1"
  },
  "dependencies": {
    "@aws-amplify/react-native": "^1.0.4",
    "@aws-amplify/rtn-web-browser": "^1.4.0",
    "@config-plugins/react-native-webrtc": "^13.0.0",
    "@expo/metro-runtime": "~6.1.2",
    "@google/generative-ai": "^0.24.1",
    "@livekit/react-native": "^2.12.0",
    "@livekit/react-native-expo-plugin": "^1.0.2",
    "@livekit/react-native-webrtc": "^144.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "7.7.3",
    "@react-navigation/native": "^7.1.19",
    "@react-navigation/stack": "^7.6.2",
    "@sentry/react-native": "~7.2.0",
    "@shopify/flash-list": "^2.3.2",
    "@shopify/react-native-skia": "2.2.12",
    "amazon-cognito-identity-js": "^6.3.20",
    "aws-amplify": "^6.0.0",
    "base-64": "^1.0.0",
    "expo": "~54.0.36",
    "expo-application": "~7.0.7",
    "expo-auth-session": "~7.0.9",
    "expo-av": "~16.0.7",
    "expo-blur": "~15.0.7",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.10",
    "expo-dev-client": "~6.0.18",
    "expo-device": "~8.0.9",
    "expo-file-system": "~19.0.17",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "~15.0.7",
    "expo-location": "~19.0.8",
    "expo-media-library": "~18.2.0",
    "expo-navigation-bar": "~5.0.10",
    "expo-notifications": "~0.32.17",
    "expo-screen-orientation": "~9.0.9",
    "expo-sharing": "~14.0.7",
    "expo-speech": "~14.0.7",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-video": "^3.0.14",
    "expo-video-thumbnails": "~10.0.7",
    "expo-web-browser": "~15.0.9",
    "firebase": "^12.5.0",
    "livekit-client": "^2.21.0",
    "lucide-react-native": "^0.552.0",
    "nativewind": "^4.1.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-compressor": "^2.0.3",
    "react-native-gesture-handler": "2.20.0",
    "react-native-get-random-values": "1.11.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-toast-message": "^2.3.3",
    "react-native-uuid": "^2.0.3",
    "react-native-view-shot": "4.0.3",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "socket.io-client": "^4.8.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@aws-sdk/client-ivs-realtime": "^3.947.0",
    "@babel/core": "^7.28.5",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@react-native-community/cli": "^20.0.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/prop-types": "^15.7.15",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@wdio/appium-service": "^9.24.0",
    "@wdio/cli": "^9.24.0",
    "@wdio/local-runner": "^9.24.0",
    "@wdio/mocha-framework": "^9.24.0",
    "@wdio/spec-reporter": "^9.24.0",
    "appium": "^3.2.0",
    "appium-uiautomator2-driver": "^7.0.0",
    "babel-plugin-lodash": "^3.3.4",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~54.0.6",
    "detox": "^20.47.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "expo-build-properties": "~0.12.5",
    "firebase-admin": "^13.5.0",
    "form-data": "^4.0.4",
    "glob": "^11.0.3",
    "jest": "~29.7.0",
    "jest-expo": "^54.0.13",
    "lodash-es": "^4.17.21",
    "metro": "^0.83.3",
    "metro-cache": "^0.83.3",
    "node-fetch": "^3.3.2",
    "patch-package": "^8.0.0",
    "react-test-renderer": "19.1.0",
    "sharp": "^0.33.5",
    "source-map-explorer": "^2.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "webdriverio": "^9.24.0"
  },
  "private": true,
  "overrides": {
    "brace-expansion": "1.1.18",
    "postcss": "8.5.25"
  }
}
