rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Privileged user fields — Admin SDK / trusted backend only.
    function userPrivFieldsFrozenOnCreate() {
      return request.resource.data.get('isAdmin', false) == false
        && request.resource.data.get('roles', []) == []
        && !('adminRoleUpdatedAt' in request.resource.data)
        && !('feedPriorityAccount' in request.resource.data)
        && !('feedPriorityAccountUpdatedAt' in request.resource.data)
        && !('feedPriorityAccountUpdatedBy' in request.resource.data)
        && !('creatorFeedWeight' in request.resource.data)
        && !('earnedBadgeIds' in request.resource.data)
        && !('earnedBadgeIdsUpdatedAt' in request.resource.data)
        && request.resource.data.get('verified', false) == false
        && request.resource.data.get('isVerified', false) == false
        && !('verificationStatus' in request.resource.data)
        && !('verificationMethod' in request.resource.data)
        && !('verifiedAt' in request.resource.data)
        && !('verificationSubmittedAt' in request.resource.data)
        && !('verificationLinkedProvider' in request.resource.data)
        && !('verificationRejectionReason' in request.resource.data);
    }

    function userPrivFieldsFrozenOnUpdate() {
      return request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
        && request.resource.data.get('roles', []) == resource.data.get('roles', [])
        && request.resource.data.get('adminRoleUpdatedAt', null)
          == resource.data.get('adminRoleUpdatedAt', null)
        && request.resource.data.get('feedPriorityAccount', null)
          == resource.data.get('feedPriorityAccount', null)
        && request.resource.data.get('feedPriorityAccountUpdatedAt', null)
          == resource.data.get('feedPriorityAccountUpdatedAt', null)
        && request.resource.data.get('feedPriorityAccountUpdatedBy', null)
          == resource.data.get('feedPriorityAccountUpdatedBy', null)
        && request.resource.data.get('creatorFeedWeight', null)
          == resource.data.get('creatorFeedWeight', null)
        && request.resource.data.get('earnedBadgeIds', [])
          == resource.data.get('earnedBadgeIds', [])
        && request.resource.data.get('earnedBadgeIdsUpdatedAt', null)
          == resource.data.get('earnedBadgeIdsUpdatedAt', null)
        && request.resource.data.get('verified', false)
          == resource.data.get('verified', false)
        && request.resource.data.get('isVerified', false)
          == resource.data.get('isVerified', false)
        && request.resource.data.get('verificationStatus', null)
          == resource.data.get('verificationStatus', null)
        && request.resource.data.get('verificationMethod', null)
          == resource.data.get('verificationMethod', null)
        && request.resource.data.get('verifiedAt', null)
          == resource.data.get('verifiedAt', null)
        && request.resource.data.get('verificationSubmittedAt', null)
          == resource.data.get('verificationSubmittedAt', null)
        && request.resource.data.get('verificationLinkedProvider', null)
          == resource.data.get('verificationLinkedProvider', null)
        && request.resource.data.get('verificationRejectionReason', null)
          == resource.data.get('verificationRejectionReason', null);
    }

    function validUsernameClaim(userId) {
      return request.resource.data.keys().hasAll(['username', 'usernameKey', 'handle'])
        && request.resource.data.username is string
        && request.resource.data.usernameKey is string
        && request.resource.data.username == request.resource.data.handle
        && getAfter(
          /databases/$(database)/documents/usernameClaims/$(request.resource.data.usernameKey)
        ).data.uid == userId
        && getAfter(
          /databases/$(database)/documents/usernameClaims/$(request.resource.data.usernameKey)
        ).data.username == request.resource.data.username;
    }

    function usernameClaimValidOnCreate(userId) {
      return !request.resource.data.keys().hasAny(['username', 'usernameKey', 'handle'])
        || validUsernameClaim(userId);
    }

    function usernameClaimValidOnUpdate(userId) {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['username', 'usernameKey', 'handle'])
        || validUsernameClaim(userId);
    }

    // Admin hide / priority on posts — clients cannot set or clear.
    function postModerationFrozenOnCreate() {
      return request.resource.data.get('moderation', {}).get('hidden', false) == false
        && !('feedPriority' in request.resource.data)
        && !('adminPriority' in request.resource.data)
        && !('feedPriorityUpdatedAt' in request.resource.data)
        && !('feedPriorityUpdatedBy' in request.resource.data);
    }

    function postModerationFrozenOnUpdate() {
      return request.resource.data.get('moderation', {}) == resource.data.get('moderation', {})
        && request.resource.data.get('feedPriority', null) == resource.data.get('feedPriority', null)
        && request.resource.data.get('adminPriority', null) == resource.data.get('adminPriority', null)
        && request.resource.data.get('feedPriorityUpdatedAt', null)
          == resource.data.get('feedPriorityUpdatedAt', null)
        && request.resource.data.get('feedPriorityUpdatedBy', null)
          == resource.data.get('feedPriorityUpdatedBy', null);
    }

    // Safe accessors for post like toggles (legacy docs may omit fields).
    function safeLikedBy(data) {
      return ('likedBy' in data && data.likedBy is list) ? data.likedBy : [];
    }

    function safeLikeInt(data, field) {
      return (field in data && data[field] is int) ? data[field] : 0;
    }

    // Non-owners may only add/remove themselves on likedBy and bump likes/likeCount by ±1.
    function canTogglePostLike() {
      let beforeLikedBy = safeLikedBy(resource.data);
      let afterLikedBy = safeLikedBy(request.resource.data);
      let beforeLikes = safeLikeInt(resource.data, 'likes');
      let beforeLikeCount = (('likeCount' in resource.data) && resource.data.likeCount is int)
        ? resource.data.likeCount
        : beforeLikes;
      let baseline = beforeLikes >= beforeLikeCount ? beforeLikes : beforeLikeCount;
      let beforeLiked = request.auth.uid in beforeLikedBy;
      let delta = beforeLiked ? -1 : 1;

      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likedBy', 'likes', 'likeCount'])
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.likes is int
        && request.resource.data.likeCount is int
        && request.resource.data.likes == request.resource.data.likeCount
        && request.resource.data.likes == baseline + delta
        && request.resource.data.likeCount == baseline + delta
        && request.resource.data.likes >= 0
        && request.resource.data.likeCount >= 0
        && (
          (
            beforeLiked
            && !(request.auth.uid in afterLikedBy)
            && afterLikedBy.size() == beforeLikedBy.size() - 1
            && beforeLikedBy.hasAll(afterLikedBy)
          )
          || (
            !beforeLiked
            && (request.auth.uid in afterLikedBy)
            && afterLikedBy.size() == beforeLikedBy.size() + 1
            && afterLikedBy.hasAll(beforeLikedBy)
          )
        );
    }

    // Wave 0: economy is server-only (blocks client mint/spend).
    match /wallets/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /gems/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /transactions/{txnId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /gifts/{giftId} {
      allow read: if isSignedIn()
        && (resource.data.fromUserId == request.auth.uid
          || resource.data.toUserId == request.auth.uid);
      allow write: if false;
    }

    // Privileged / telemetry collections — no client access.
    match /roles/{docId} { allow read, write: if false; }
    match /moderation/{docId} { allow read, write: if false; }
    match /moderationQueue/{docId} { allow read, write: if false; }
    match /analytics/{docId} { allow read, write: if false; }
    match /alerts/{docId} { allow read, write: if false; }
    // Trusted feed adapters only; Admin SDK writes bypass rules.
    match /topicEvents/{eventId} { allow read, write: if false; }
    match /reports/{docId} {
      allow read: if isSignedIn() && resource.data.reporterId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if false;
    }

    // Append-only Trust & Safety audit trail (client may create; never mutate/delete).
    match /safetyAuditLogs/{docId} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.createdAt is int;
      allow update, delete: if false;
    }

    // Scanner / NLP flags (client create for live scanner; triage is admin-only).
    match /moderationFlags/{docId} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.source is string
        && request.resource.data.createdAt is int;
      allow update, delete: if false;
    }

    // Privacy lifecycle requests (export/deletion). Client create only; ops process offline.
    match /privacyRequests/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type in ['export', 'deletion']
        && request.resource.data.status == 'queued';
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        && userPrivFieldsFrozenOnCreate()
        && usernameClaimValidOnCreate(userId);
      allow update: if isOwner(userId)
        && userPrivFieldsFrozenOnUpdate()
        && usernameClaimValidOnUpdate(userId);
      allow delete: if false;

      // Blocks fake_follower_* minting (doc id must equal auth uid).
      match /followers/{followerId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == followerId;
        allow delete: if isSignedIn()
          && (request.auth.uid == followerId || request.auth.uid == userId);
        allow update: if false;
      }
      match /following/{followingId} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(userId);
        allow update: if false;
      }

      // Explicit per-topic opt-ins. Missing docs are OFF by default.
      match /topicNotifications/{topicId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys()
            .hasOnly(['userId', 'topicId', 'enabled', 'updatedAt'])
          && request.resource.data.keys()
            .hasAll(['userId', 'topicId', 'enabled', 'updatedAt'])
          && request.resource.data.userId == userId
          && request.resource.data.topicId == topicId
          && request.resource.data.enabled is bool
          && request.resource.data.updatedAt is int;
        allow delete: if isOwner(userId);
      }

      // Global push category prefs. Missing doc → server defaults.
      match /notificationSettings/{settingsId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && settingsId == 'global'
          && request.resource.data.userId == userId
          && request.resource.data.updatedAt is int
          && request.resource.data.keys().hasAll(['userId', 'updatedAt'])
          && request.resource.data.keys().hasOnly([
            'userId', 'updatedAt', 'pushEnabled', 'categories'
          ])
          && (!('pushEnabled' in request.resource.data)
            || request.resource.data.pushEnabled is bool)
          && (!('categories' in request.resource.data)
            || request.resource.data.categories is map);
        allow delete: if isOwner(userId) && settingsId == 'global';
      }

      // Per-person overrides. Doc id must equal targetUid.
      match /notificationOverrides/{targetUid} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.targetUid == targetUid
          && request.resource.data.updatedAt is int
          && request.resource.data.keys().hasAll(['userId', 'targetUid', 'updatedAt'])
          && request.resource.data.keys().hasOnly([
            'userId', 'targetUid', 'updatedAt', 'mode', 'categories'
          ])
          && (!('mode' in request.resource.data)
            || request.resource.data.mode in ['custom', 'everything', 'nothing'])
          && (!('categories' in request.resource.data)
            || request.resource.data.categories is map);
        allow delete: if isOwner(userId);
      }

      // User blocks — owner can write; others cannot read (privacy).
      match /blocks/{targetUid} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.createdAt is int;
        allow delete: if isOwner(userId);
      }
    }

    match /userProfiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Atomic, lowercase public-handle ownership. Profile writes pair this claim
    // with users/{uid}.usernameKey in a single client transaction.
    match /usernameClaims/{usernameKey} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && usernameKey.matches('^[a-z0-9_.]{3,20}$');
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && usernameKey.matches('^[a-z0-9_.]{3,20}$');
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && postModerationFrozenOnCreate();
      // Owner may edit their post; any signed-in user may toggle their own like.
      allow update: if isSignedIn() && (
        (
          resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && postModerationFrozenOnUpdate()
        )
        || canTogglePostLike()
      );
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      // Feed comments (CommentsModal writes here). Without this block,
      // deny-by-default rejects every comment create/like.
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAll(['userId', 'text', 'createdAt']);
        allow update: if isSignedIn() && (
          resource.data.userId == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likes', 'likedBy'])
        );
        allow delete: if isSignedIn()
          && resource.data.userId == request.auth.uid;
      }
    }

    match /chats/{chatId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /chatRooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid;
      // Creator full control; members may join/leave and claim page ambassador.
      allow update: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid
        || request.auth.uid in request.resource.data.participants
        || request.auth.uid in resource.data.participants
      );
      allow delete: if isSignedIn()
        && resource.data.createdBy == request.auth.uid;
    }

    match /chatMessages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    match /gameRooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.hostId == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn()
        && resource.data.hostId == request.auth.uid;
    }

    match /socialImports/{importId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll([
          'uid', 'platform', 'handle', 'status', 'createdAt', 'updatedAt'
        ]);
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status in ['pending', 'running']
        && request.resource.data.status == 'canceled'
        && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    // Dating (keep in sync with firestore.wave0-live.rules — deploy source of truth).
    // Phase 5: soft age gate — optedIn requires self-reported birthYear (int).
    // Likes/passes are written only via Cloud Functions (Admin SDK); clients read.
    // Phase 4 fields still allowed: prompts, photoRefs, useProfilePhoto, gender,
    // lookingFor, ageMin, ageMax, maxDistanceKm, geoLat, geoLon, geoUpdatedAt.
    match /datingPrefs/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasAll([
          'optedIn', 'adultConfirmed', 'adultConfirmedAt', 'bio', 'updatedAt'
        ])
        && request.resource.data.optedIn is bool
        && request.resource.data.adultConfirmed is bool
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 280
        && (
          !request.resource.data.optedIn
          || (
            request.resource.data.keys().hasAny(['birthYear'])
            && request.resource.data.birthYear is int
            && request.resource.data.birthYear >= 1920
            && request.resource.data.birthYear <= 2100
          )
        );
      allow delete: if isOwner(uid);
    }

    match /datingPasses/{passId} {
      allow read: if isSignedIn()
        && resource.data.fromUid == request.auth.uid;
      // Phase 5: create via blypDatingPass (Admin SDK). Owner may delete own pass.
      allow create: if false;
      allow update: if false;
      allow delete: if isSignedIn()
        && resource.data.fromUid == request.auth.uid;
    }

    match /datingLikes/{likeId} {
      allow read: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
      // Phase 5: create via blypDatingLike only (Admin SDK) — no client forge.
      allow create, update, delete: if false;
    }

    match /datingMatches/{matchId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.members;
      allow write: if false;
    }

    // Club membership denorm (Phase 2). Primary discovery still queries
    // users.profileClubs array-contains; this index supports counts/pages later.
    match /clubMemberships/{clubId}/members/{memberId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == memberId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.clubId == clubId;
      allow delete: if isSignedIn() && request.auth.uid == memberId;
      allow update: if false;
    }

    // Earnable badges (Phase 3). Server Admin SDK mints only; clients equip subset.
    match /badgeAwards/{userId}/items/{badgeId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Profile verification audit — Admin SDK (blypVerificationSubmit) only.
    match /verificationRequests/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Prearranged 1v1 battles (keep in sync with firestore.wave0-live.rules).
    match /battles/{battleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.creatorUid == request.auth.uid
        && request.auth.uid in request.resource.data.participantsUids
        && request.resource.data.creatorUid in request.resource.data.participantsUids
        && request.resource.data.opponentUid in request.resource.data.participantsUids
        && request.resource.data.keys().hasAll([
          'creatorUid', 'opponentUid', 'participantsUids', 'status',
          'scheduledStartAt', 'createdAt', 'updatedAt'
        ]);
      allow update: if isSignedIn() && (
        (
          request.auth.uid in resource.data.participantsUids
          && request.resource.data.creatorUid == resource.data.creatorUid
          && request.resource.data.opponentUid == resource.data.opponentUid
          && request.resource.data.participantsUids == resource.data.participantsUids
        )
        || request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['score', 'updatedAt'])
      );
      allow delete: if false;

      match /votes/{voterUid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == voterUid;
        allow update, delete: if false;
      }

      match /reminders/{uid} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow create, update, delete: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // Durable push outbox + in-app notification inbox (admin broadcasts, teams, battles).
    // Admin SDK writes; clients may only read their own and flip status → read.
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, delete: if false;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'readAt'])
        && request.resource.data.status == 'read';
    }

    // Deny-by-default for everything else (closes universal auth write).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
