rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }
    
    // ========= DEV-OPEN: Live & Streams (Cognito-only env) =========
    // WARNING: These rules must be tightened before production.
    // They currently allow full read/write for liveStreams, streams, users, and userProfiles.
    
    // Main stream documents
    match /liveStreams/{streamId} {
      // DEV-OPEN: Live/Streams temporarily fully open for Blyp finish phase.
      allow read, write: if true;
      
      // Segment subcollection
      match /segments/{segmentId} {
        // DEV-OPEN: Live/Streams temporarily fully open for Blyp finish phase.
        allow read, write: if true;
      }
      
      // Comments subcollection
      match /comments/{commentId} {
        // DEV-OPEN: Live/Streams temporarily fully open for Blyp finish phase.
        allow read, write: if true;
      }
      
      // Likes subcollection
      match /likes/{userId} {
        // DEV-OPEN: Live/Streams temporarily fully open for Blyp finish phase.
        allow read, write: if true;
      }
      
      // Gifts subcollection (live streaming)
      match /gifts/{giftId} {
        allow read, write: if true;
      }
      
      // Viewers subcollection (live streaming)
      match /viewers/{viewerId} {
        allow read, write: if true;
      }
      
      // Controls subcollection (moderation)
      match /controls/{controlId} {
        allow read, write: if true;
      }
    }
    
    // User profile documents
    match /userProfiles/{userId} {
      // DEV-OPEN: Live/Streams temporarily fully open for Blyp finish phase.
      allow read, write: if true;
    }
    
    // LiveService user presence
    match /users/{userId} {
      // DEV-OPEN: Live/Streams temporarily fully open for Blyp finish phase.
      allow read, write: if true;
      
      // User subcollections
      match /followers/{followerId} {
        allow read, write: if true;
      }
      
      match /following/{followingId} {
        allow read, write: if true;
      }
      
      match /liveStreamStats/{statsId} {
        allow read, write: if true;
      }
      
      match /chats/{chatId} {
        allow read, write: if true;
        
        match /messages/{messageId} {
          allow read, write: if true;
        }
      }
    }
    
    // LiveService stream metadata
    match /streams/{streamId} {
      // DEV-OPEN: Live/Streams temporarily fully open for Blyp finish phase.
      allow read, write: if true;
      
      // Stream messages subcollection
      match /messages/{messageId} {
        // DEV-OPEN: Live/Streams temporarily fully open for Blyp finish phase.
        allow read, write: if true;
      }
    }
    
    // ========== DEV-OPEN: Core App & Economy Collections ==========
    // WARNING: DEV ONLY – must be tightened before production.
    
    // Posts feed & user posts
    match /posts/{postId} {
      allow read, write: if true;
    }
    
    // Activity feed / notifications
    match /activities/{activityId} {
      allow read, write: if true;
    }
    
    // Economy: transactions, wallets, gems, gifts
    match /transactions/{transactionId} {
      allow read, write: if true;
    }
    
    match /wallets/{walletId} {
      allow read, write: if true;
    }
    
    match /gems/{gemId} {
      allow read, write: if true;
    }
    
    match /gifts/{giftId} {
      allow read, write: if true;
    }
    
    // Moderation queues and actions
    match /moderationQueue/{itemId} {
      allow read, write: if true;
    }
    
    match /moderationActions/{actionId} {
      allow read, write: if true;
    }
    
    // User reports
    match /reports/{reportId} {
      allow read, write: if true;
    }
    
    // Post drafts
    match /drafts/{draftId} {
      allow read, write: if true;
    }
    
    // Legacy followers collection (older schema)
    match /followers/{followerDocId} {
      allow read, write: if true;
    }
    
    // Chats and chat rooms
    match /chats/{chatId} {
      allow read, write: if true;
      
      // Chat messages subcollection
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
    
    match /chatRooms/{roomId} {
      allow read, write: if true;
    }
    
    // Game rooms
    match /gameRooms/{gameRoomId} {
      allow read, write: if true;
    }
    
    // Analytics & alerts
    match /analytics/{analyticsId} {
      allow read, write: if true;
    }
    
    match /alerts/{alertId} {
      allow read, write: if true;
    }
    
    // Remote config (e.g., streaming feature flags)
    match /appConfig/{configId} {
      allow read, write: if true;
    }
    
    // Test collection used by FirebaseTestScreen
    match /test/{testId} {
      allow read, write: if true;
    }
    
    // Live users directory (for live streaming tab)
    match /liveUsers/{userId} {
      allow read, write: if true;
    }
    
    // Conversations / direct messages
    match /conversations/{conversationId} {
      allow read, write: if true;
      
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
    
    // Stream analytics (if used)
    match /streamAnalytics/{analyticsId} {
      allow read, write: if true;
    }
    
    // Stream alerts (if used)
    match /streamAlerts/{alertId} {
      allow read, write: if true;
    }
    
    // ========== DEFAULT DENY ==========
    // All other collections are denied by default
  }
}