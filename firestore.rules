rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read any user profile (for public info) but only write their own
    match /users/{userId} {
      // Anyone can read user profiles (for usernames, avatars, etc.)
      allow read: if request.auth != null;
      // Only the user can write/update their own profile
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // User subcollections
      match /following/{followingId} {
        // Users can read and write their own following list
        allow read, write: if request.auth != null && request.auth.uid == userId;
        // Allow others to read following lists (for social features)
        allow read: if request.auth != null;
      }
      
      match /followers/{followerId} {
        // Users can read their own followers list
        allow read: if request.auth != null && request.auth.uid == userId;
        // Allow others to read followers lists (for social features)  
        allow read: if request.auth != null;
        // Users can update when they follow/unfollow someone
        allow write: if request.auth != null;
      }
    }
    
    // Posts collection rules
    match /posts/{postId} {
      // Anyone can read posts
      allow read: if true;
      
      // Only authenticated users can create posts with their own userId
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      
      // Only the post owner can delete posts
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Users can update posts they own (for editing)
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Allow users to update likes and likedBy fields on any post
      allow update: if request.auth != null && 
        // Only allow updating likes and likedBy fields
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy']) &&
        // Ensure likes is a number and likedBy is an array
        request.resource.data.likes is number &&
        request.resource.data.likedBy is list &&
        // Ensure the user is adding/removing themselves from likedBy
        (
          // Adding self to likedBy (liking)
          (request.resource.data.likedBy.hasAll(resource.data.likedBy) && 
           request.resource.data.likedBy.removeAll(resource.data.likedBy) == [request.auth.uid] &&
           request.resource.data.likes == resource.data.likes + 1) ||
          // Removing self from likedBy (unliking)  
          (resource.data.likedBy.hasAll(request.resource.data.likedBy) && 
           resource.data.likedBy.removeAll(request.resource.data.likedBy) == [request.auth.uid] &&
           request.resource.data.likes == resource.data.likes - 1)
        );
    }
    
    // Activities collection rules
    match /activities/{activityId} {
      // Users can read their own activities (as target user)
      allow read: if request.auth != null && request.auth.uid == resource.data.targetUserId;
      
      // Users can create activities for any other user (normal case)
      allow create: if request.auth != null && request.auth.uid == request.resource.data.actorId;
      
      // Users can update their own activities (mark as read)
      allow update: if request.auth != null && request.auth.uid == resource.data.targetUserId;
    }

    // Chat collection rules
    match /chats/{chatId} {
      // Users can read chats they are participants in
      allow read: if request.auth != null && 
        request.auth.uid in resource.data.participants;
      
      // Users can create chats if they are one of the participants
      allow create: if request.auth != null && 
        request.auth.uid in request.resource.data.participants;
      
      // Users can update chats they are participants in
      allow update: if request.auth != null && 
        request.auth.uid in resource.data.participants;
      
      // Users can delete chats they are participants in
      allow delete: if request.auth != null && 
        request.auth.uid in resource.data.participants;
      
      // Messages subcollection rules
      match /messages/{messageId} {
        // Users can read messages in chats they participate in
        allow read: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        
        // Users can create messages in chats they participate in
        allow create: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          request.auth.uid == request.resource.data.senderId;
        
        // Users can update their own messages
        allow update: if request.auth != null && 
          request.auth.uid == resource.data.senderId;
        
        // Users can delete their own messages
        allow delete: if request.auth != null && 
          request.auth.uid == resource.data.senderId;
      }
    }

    // Balances collection rules (for Blyp Coins)
    match /balances/{userId} {
      // Users can read and write their own balance
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Gems collection rules (for Blyp Gems)
    match /gems/{userId} {
      // Users can read and write their own gems
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Wallets collection rules (for Blyp Coins)
    match /wallets/{userId} {
      // Users can read and write their own wallet
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Transactions collection rules
    match /transactions/{transactionId} {
      // Users can read their own transactions
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.fromUserId || 
         request.auth.uid == resource.data.toUserId || 
         request.auth.uid == resource.data.userId);
      // System can create transactions
      allow create: if request.auth != null;
    }

    // Gifts collection rules  
    match /gifts/{giftId} {
      // Users can read their own gifts (sent or received)
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.fromUserId || 
         request.auth.uid == resource.data.toUserId);
      // Users can create gifts
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fromUserId;
    }

    // Game rooms collection rules
    match /gameRooms/{roomId} {
      // Anyone can read game rooms
      allow read: if request.auth != null;
      // Users can create game rooms
      allow create: if request.auth != null;
      // Room creators and participants can update
      allow update: if request.auth != null;
    }

    // Chat rooms collection rules
    match /chatRooms/{roomId} {
      // Authenticated users can read all chat rooms (for browsing)
      allow read: if request.auth != null;
      // Users can create chat rooms
      allow create: if request.auth != null && 
        request.auth.uid in request.resource.data.participants;
      // Participants can update chat rooms (join/leave, etc.)
      allow update: if request.auth != null && 
        (request.auth.uid in resource.data.participants ||
         request.auth.uid in request.resource.data.participants);
    }

    // Chat messages collection rules  
    match /chatMessages/{messageId} {
      // Users can read messages in rooms they participate in
      allow read: if request.auth != null;
      // Users can create messages
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.senderId;
      // Users can update their own messages
      allow update: if request.auth != null && 
        request.auth.uid == resource.data.senderId;
    }

    // Following collection rules
    match /following/{userId} {
      // Users can read and write their own following list
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow others to read following lists (for social features)
      allow read: if request.auth != null;
    }

    // Followers collection rules
    match /followers/{userId} {
      // Users can read their own followers list
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow others to read followers lists (for social features)
      allow read: if request.auth != null;
      
      // Users can update when they follow/unfollow someone
      allow write: if request.auth != null;
    }

    // Comments collection rules
    match /comments/{commentId} {
      // Anyone can read comments
      allow read: if request.auth != null;
      
      // Users can create comments with their own userId
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      
      // Users can update/delete their own comments
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Livestream rules
    match /liveStreams/{streamId} {
      // Anyone can read livestreams
      allow read: if request.auth != null;
      
      // Only authenticated users can create livestreams with their own userId
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      
      // Creator can fully update their stream
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        // Viewers can only update specific interaction fields
        (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['viewCount', 'likeCount', 'commentCount']))
      );
      
      // Only the stream creator can delete streams
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Stream comments subcollection
      match /comments/{commentId} {
        // Anyone can read stream comments
        allow read: if request.auth != null;
        
        // Users can create comments with their own userId
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
        
        // Users can update/delete their own comments or stream creators can moderate
        allow update, delete: if request.auth != null && (
          request.auth.uid == resource.data.userId ||
          request.auth.uid == get(/databases/$(database)/documents/liveStreams/$(streamId)).data.userId
        );
      }
      
      // Stream likes subcollection
      match /likes/{userId} {
        // Anyone can read likes
        allow read: if request.auth != null;
        
        // Users can only like/unlike as themselves
        allow write: if request.auth != null && userId == request.auth.uid;
      }
    }

    // Default deny all other operations
    match /{document=**} {
      allow read, write: if false;
    }
  }
}