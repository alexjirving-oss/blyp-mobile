rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isLegacyAuthenticatedCollection(collectionName) {
      return request.auth != null
        && collectionName != 'wallets'
        && collectionName != 'gems'
        && collectionName != 'transactions'
        && collectionName != 'ledger_entries'
        && collectionName != 'gift_catalog'
        && collectionName != 'gift_events'
        && collectionName != 'iap_products';
    }

    // The canonical economy is PostgreSQL-backed and reachable only through the
    // authenticated backend API. Firebase Admin/servers bypass these client rules.
    match /wallets/{document=**} {
      allow read, write: if false;
    }
    match /gems/{document=**} {
      allow read, write: if false;
    }
    match /transactions/{document=**} {
      allow read, write: if false;
    }
    match /ledger_entries/{document=**} {
      allow read, write: if false;
    }
    match /gift_catalog/{document=**} {
      allow read, write: if false;
    }
    match /gift_events/{document=**} {
      allow read, write: if false;
    }
    match /iap_products/{document=**} {
      allow read, write: if false;
    }

    // Legacy authenticated access remains temporarily available to unrelated
    // collections while their domain-specific policy migrations are delivered.
    match /{collectionName}/{document=**} {
      allow read, write: if isLegacyAuthenticatedCollection(collectionName);
    }
  }
}
