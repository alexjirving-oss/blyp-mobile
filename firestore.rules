rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Wave 0: economy is server-only (blocks client mint/spend).
    match /wallets/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /gems/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /transactions/{txnId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /gifts/{giftId} {
      allow read: if isSignedIn()
        && (resource.data.fromUserId == request.auth.uid
          || resource.data.toUserId == request.auth.uid);
      allow write: if false;
    }

    // Privileged / telemetry collections — no client access.
    match /roles/{docId} { allow read, write: if false; }
    match /moderation/{docId} { allow read, write: if false; }
    match /moderationQueue/{docId} { allow read, write: if false; }
    match /analytics/{docId} { allow read, write: if false; }
    match /alerts/{docId} { allow read, write: if false; }
    match /reports/{docId} {
      allow read: if isSignedIn() && resource.data.reporterId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if false;
    }

    // Privacy lifecycle requests (export/deletion). Client create only; ops process offline.
    match /privacyRequests/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type in ['export', 'deletion']
        && request.resource.data.status == 'queued';
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;

      // Blocks fake_follower_* minting (doc id must equal auth uid).
      match /followers/{followerId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == followerId;
        allow delete: if isSignedIn()
          && (request.auth.uid == followerId || request.auth.uid == userId);
        allow update: if false;
      }
      match /following/{followingId} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(userId);
        allow update: if false;
      }
    }

    match /userProfiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /chats/{chatId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /chatRooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.createdBy == request.auth.uid;
    }

    match /chatMessages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    match /gameRooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.hostId == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn()
        && resource.data.hostId == request.auth.uid;
    }

    // Deny-by-default for everything else (closes universal auth write).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
