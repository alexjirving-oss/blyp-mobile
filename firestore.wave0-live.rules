rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Privileged user fields — Admin SDK / trusted backend only.
    function userPrivFieldsFrozenOnCreate() {
      return request.resource.data.get('isAdmin', false) == false
        && request.resource.data.get('roles', []) == []
        && !('adminRoleUpdatedAt' in request.resource.data)
        && !('feedPriorityAccount' in request.resource.data)
        && !('feedPriorityAccountUpdatedAt' in request.resource.data)
        && !('feedPriorityAccountUpdatedBy' in request.resource.data)
        && !('creatorFeedWeight' in request.resource.data)
        && !('earnedBadgeIds' in request.resource.data)
        && !('earnedBadgeIdsUpdatedAt' in request.resource.data);
    }

    function userPrivFieldsFrozenOnUpdate() {
      return request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
        && request.resource.data.get('roles', []) == resource.data.get('roles', [])
        && request.resource.data.get('adminRoleUpdatedAt', null)
          == resource.data.get('adminRoleUpdatedAt', null)
        && request.resource.data.get('feedPriorityAccount', null)
          == resource.data.get('feedPriorityAccount', null)
        && request.resource.data.get('feedPriorityAccountUpdatedAt', null)
          == resource.data.get('feedPriorityAccountUpdatedAt', null)
        && request.resource.data.get('feedPriorityAccountUpdatedBy', null)
          == resource.data.get('feedPriorityAccountUpdatedBy', null)
        && request.resource.data.get('creatorFeedWeight', null)
          == resource.data.get('creatorFeedWeight', null)
        && request.resource.data.get('earnedBadgeIds', [])
          == resource.data.get('earnedBadgeIds', [])
        && request.resource.data.get('earnedBadgeIdsUpdatedAt', null)
          == resource.data.get('earnedBadgeIdsUpdatedAt', null);
    }

    // Admin hide / priority on posts — clients cannot set or clear.
    function postModerationFrozenOnCreate() {
      return request.resource.data.get('moderation', {}).get('hidden', false) == false
        && !('feedPriority' in request.resource.data)
        && !('adminPriority' in request.resource.data)
        && !('feedPriorityUpdatedAt' in request.resource.data)
        && !('feedPriorityUpdatedBy' in request.resource.data);
    }

    function postModerationFrozenOnUpdate() {
      return request.resource.data.get('moderation', {}) == resource.data.get('moderation', {})
        && request.resource.data.get('feedPriority', null) == resource.data.get('feedPriority', null)
        && request.resource.data.get('adminPriority', null) == resource.data.get('adminPriority', null)
        && request.resource.data.get('feedPriorityUpdatedAt', null)
          == resource.data.get('feedPriorityUpdatedAt', null)
        && request.resource.data.get('feedPriorityUpdatedBy', null)
          == resource.data.get('feedPriorityUpdatedBy', null);
    }

    // Wave 0: economy is server-only (blocks client mint/spend).
    match /wallets/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /gems/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /transactions/{txnId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /gifts/{giftId} {
      allow read: if isSignedIn()
        && (resource.data.fromUserId == request.auth.uid
          || resource.data.toUserId == request.auth.uid);
      allow write: if false;
    }

    // Privileged / telemetry collections — no client access.
    match /roles/{docId} { allow read, write: if false; }
    match /moderation/{docId} { allow read, write: if false; }
    match /moderationQueue/{docId} { allow read, write: if false; }
    match /analytics/{docId} { allow read, write: if false; }
    match /alerts/{docId} { allow read, write: if false; }
    match /reports/{docId} {
      allow read: if isSignedIn() && resource.data.reporterId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if false;
    }

    // Privacy lifecycle requests (export/deletion). Client create only; ops process offline.
    match /privacyRequests/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type in ['export', 'deletion']
        && request.resource.data.status == 'queued';
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && userPrivFieldsFrozenOnCreate();
      allow update: if isOwner(userId) && userPrivFieldsFrozenOnUpdate();
      allow delete: if false;

      match /followers/{followerId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == followerId;
        allow delete: if isSignedIn()
          && (request.auth.uid == followerId || request.auth.uid == userId);
        allow update: if false;
      }
      match /following/{followingId} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(userId);
        allow update: if false;
      }

      match /blocks/{blockedId} {
        allow read, write: if isOwner(userId);
      }

      match /deviceTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }

      // PushService + FCM sender use users/{uid}/devices/{deviceId}
      match /devices/{deviceId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /userProfiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && postModerationFrozenOnCreate();
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && postModerationFrozenOnUpdate();
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      // Feed comments (CommentsModal). Missing this → deny-by-default.
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAll(['userId', 'text', 'createdAt']);
        allow update: if isSignedIn() && (
          resource.data.userId == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likes', 'likedBy'])
        );
        allow delete: if isSignedIn()
          && resource.data.userId == request.auth.uid;
      }
    }

    match /chats/{chatId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /chatRooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid;
      // Creator full control; members may join/leave and claim page ambassador.
      allow update: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid
        || request.auth.uid in request.resource.data.participants
        || request.auth.uid in resource.data.participants
      );
      allow delete: if isSignedIn()
        && resource.data.createdBy == request.auth.uid;
    }

    match /chatMessages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    match /gameRooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.hostId == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn()
        && resource.data.hostId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // LIVE (restored): Wave 0 deny-by-default had blocked go-live directory
    // registration after IVS stage join ("Missing or insufficient permissions").
    // -------------------------------------------------------------------------
    match /liveStreams/{streamId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        (request.resource.data.get('userId', '') == request.auth.uid
         || request.resource.data.get('hostUid', '') == request.auth.uid);
      allow update: if isSignedIn() && (
        (
          (resource.data.get('userId', '') == request.auth.uid
           || resource.data.get('hostUid', '') == request.auth.uid)
          && request.resource.data.get('userId', '') == resource.data.get('userId', '')
          && request.resource.data.get('hostUid', '') == resource.data.get('hostUid', '')
        )
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['viewCount','viewerCount','likes','peakViewerCount','lastUpdated','lastActivity','totalViews','lastHeartbeatAt','directoryReady','status'])
      );
      allow delete: if isSignedIn() &&
        (resource.data.get('userId', '') == request.auth.uid
         || resource.data.get('hostUid', '') == request.auth.uid);

      match /segments/{segmentId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() &&
          get(/databases/$(database)/documents/liveStreams/$(streamId)).data.get('userId', '') == request.auth.uid;
      }
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() &&
          (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid);
      }
      match /likes/{likeUserId} {
        allow read: if isSignedIn();
        allow write: if isOwner(likeUserId);
      }
    }

    match /streams/{streamId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        (request.resource.data.get('hostUid', '') == request.auth.uid
         || request.resource.data.get('userId', '') == request.auth.uid);
      allow update: if isSignedIn() && (
        (
          (resource.data.get('hostUid', '') == request.auth.uid
           || resource.data.get('userId', '') == request.auth.uid)
          && request.resource.data.get('hostUid', '') == resource.data.get('hostUid', '')
          && request.resource.data.get('userId', '') == resource.data.get('userId', '')
        )
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['viewerCount','peakViewerCount','likes','lastUpdated','lastActivity','totalViews','status','endedAt'])
      );
      allow delete: if isSignedIn() &&
        (resource.data.get('hostUid', '') == request.auth.uid
         || resource.data.get('userId', '') == request.auth.uid);

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
        allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      }
    }

    // 1:1 audio calls (Phone tab). Participants only; status transitions client-driven.
    match /calls/{callId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.status == 'ringing'
        && request.resource.data.type == 'audio';
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.calleeId == resource.data.calleeId
        && request.resource.data.status in ['ringing', 'active', 'ended', 'missed', 'declined'];
      allow delete: if false;
    }

    // Inbox / DM directory used by MessengerScreen
    match /conversations/{convId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds is list;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds
          && (request.resource.data.senderId == request.auth.uid
              || request.resource.data.uid == request.auth.uid);
        allow update, delete: if false;
      }
    }

    match /entitlements/{userId} {
      allow read: if isOwner(userId);
      // Clients may only bootstrap their own trial; paid tiers are server-written.
      allow create: if isOwner(userId)
        && request.resource.data.tier == 'trial'
        && request.resource.data.status == 'trialing'
        && request.resource.data.keys().hasAll(['tier', 'status', 'trialStartedAt', 'trialEndsAt', 'updatedAt'])
        && !(request.resource.data.keys().hasAny(['currentPeriodEnd', 'store', 'purchaseToken']));
      allow update, delete: if false;
    }

    // Bring-your-content import requests (client creates pending; worker uses Admin SDK).
    match /socialImports/{importId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll([
          'uid', 'platform', 'handle', 'status', 'createdAt', 'updatedAt'
        ]);
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status in ['pending', 'running']
        && request.resource.data.status == 'canceled'
        && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    // Official creator teams (agencies). Team docs are created by admin/backend
    // when a teamApplications entry is approved; clients manage join flow.
    function isTeamLeader(teamId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/teams/$(teamId)).data.leaderId
          == request.auth.uid;
    }

    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow create, delete: if false;
      allow update: if isTeamLeader(teamId);

      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create, update: if isTeamLeader(teamId);
        allow delete: if isSignedIn()
          && (memberId == request.auth.uid || isTeamLeader(teamId));
      }

      match /joinRequests/{requestId} {
        allow read: if isSignedIn()
          && (requestId == request.auth.uid || isTeamLeader(teamId));
        allow create: if isSignedIn()
          && requestId == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending';
        allow update: if isTeamLeader(teamId);
        allow delete: if false;
      }

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Apply to run a team — applicant owns their application doc.
    match /teamApplications/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow delete: if false;
    }

    match /auditions/{auditionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.aUid == request.auth.uid;
      allow update: if isSignedIn()
        && (resource.data.aUid == request.auth.uid
          || resource.data.bUid == request.auth.uid
          || resource.data.leaderId == request.auth.uid);
      allow delete: if false;
    }

    match /teamBattles/{battleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if false;
    }

    // Dating (subscription-package surface). Phase 5: likes/passes via CF only;
    // optedIn requires self-reported birthYear. Matches remain server-only.
    // Phase 4 fields (not in hasAll): prompts[], photoRefs[], useProfilePhoto,
    // gender, lookingFor[], ageMin, ageMax, maxDistanceKm, geoLat, geoLon, geoUpdatedAt.
    match /datingPrefs/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasAll([
          'optedIn', 'adultConfirmed', 'adultConfirmedAt', 'bio', 'updatedAt'
        ])
        && request.resource.data.optedIn is bool
        && request.resource.data.adultConfirmed is bool
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 280
        && (
          !request.resource.data.optedIn
          || (
            request.resource.data.keys().hasAny(['birthYear'])
            && request.resource.data.birthYear is int
            && request.resource.data.birthYear >= 1920
            && request.resource.data.birthYear <= 2100
          )
        );
      allow delete: if isOwner(uid);
    }

    match /datingPasses/{passId} {
      allow read: if isSignedIn()
        && resource.data.fromUid == request.auth.uid;
      allow create: if false;
      allow update: if false;
      allow delete: if isSignedIn()
        && resource.data.fromUid == request.auth.uid;
    }

    match /datingLikes/{likeId} {
      allow read: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /datingMatches/{matchId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.members;
      allow write: if false;
    }

    // Earnable badges (Phase 3). Server Admin SDK mints only; clients equip subset.
    match /badgeAwards/{userId}/items/{badgeId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Deny-by-default for everything else (keeps Wave 0 lockdown).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
