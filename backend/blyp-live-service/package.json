{
  "name": "blyp-live-service",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "worker:dev": "node ./scripts/not-implemented.cjs worker:dev",
    "worker:start": "node ./scripts/not-implemented.cjs worker:start",
    "migrate": "npm run build && node dist/scripts/ensureSchemaCli.js",
    "migrate:rollback": "node ./scripts/not-implemented.cjs migrate:rollback",
    "test": "npm run build && node --test dist/auth/cognitoClaims.test.js dist/auth/cognitoSub.test.js dist/economy/withdrawalGuard.test.js",
    "lint": "echo 'add eslint if needed'"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1006.0",
    "@aws-sdk/client-dynamodb": "^3.624.0",
    "@aws-sdk/client-ivs-realtime": "^3.624.0",
    "@aws-sdk/lib-dynamodb": "^3.624.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.19.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.0.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "knex": "^3.1.0",
    "pg": "^8.13.1",
    "pino": "^9.4.0",
    "socket.io": "^4.8.1",
    "stripe": "^17.4.0",
    "uuid": "^9.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^9.0.8",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
